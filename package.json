{
  "name": "eslint-plugin-css-property-order",
  "version": "1.0.0",
  "description": "ESLint plugin enforcing CSS declaration order for @eslint/css: Recess/Bootstrap logical order, Chrome DevTools panel order, or your own.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "css",
    "property-order",
    "declaration-order",
    "properties-order",
    "recess",
    "devtools",
    "stylelint-order"
  ],
  "homepage": "https://github.com/dmnsgn/eslint-plugin-css-property-order",
  "bugs": "https://github.com/dmnsgn/eslint-plugin-css-property-order/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmnsgn/eslint-plugin-css-property-order.git"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://paypal.me/dmnsgn"
    },
    {
      "type": "individual",
      "url": "https://commerce.coinbase.com/checkout/56cbdf28-e323-48d8-9c98-7019e72c97f3"
    }
  ],
  "license": "MIT",
  "author": "Damien Seguin (https://github.com/dmnsgn)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "generate": "node scripts/generate-orders.js",
    "generate:refresh": "node scripts/generate-orders.js --refresh",
    "report:w3c": "node scripts/report-w3c-coverage.js",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "stylelint-config-recess-order": "^7.7.0"
  },
  "peerDependencies": {
    "@eslint/css": ">=1.0.0",
    "eslint": ">=9.15.0"
  },
  "packageManager": "npm@10.5.1",
  "engines": {
    "node": ">=22.0.0",
    "snowdev": ">=3.0.0-alpha.1"
  },
  "snowdev": {
    "dependencies": [],
    "dev": {
      "serve": false
